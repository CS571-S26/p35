    "learning_outcomes": "- Program front-end user-facing software elements using state-of-the-art programming languages, frameworks, and libraries.\n- Engage in design thinking to ideate and communicate UI design solutions.\n- Prototype and develop UIs for web, mobile, and VUIs.\n- Follow user-centered design principles to iteratively build, assess, and refine design solutions.\n- Create visual designs, layouts, and navigation structures using design languages and elements.",
    "policies": [
        {
            "policy_name": "Late Work",
            "summary": "Students have 10 late days for homework; each day late beyond this incurs a 10% penalty. No late submissions for ICAs and web project milestones beyond one day are accepted, with a 5% penalty per hour."
        },
        {
            "policy_name": "Academic Integrity",
            "summary": "AI use is restricted on homework and ICAs and is treated as proprietary company information not to be shared with AI tools. AI is permitted for the web project, but students must be able to explain their work."
        },
        {
            "policy_name": "Accommodations",
            "summary": "Students requiring accommodations must inform the instructor by week three or as soon as possible, for timely implementation of necessary accommodations."
        }
    ],
